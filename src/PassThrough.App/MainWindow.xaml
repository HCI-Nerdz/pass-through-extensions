<Window x:Class="PassThrough.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Pass-through Extensions · HCI Nerdz"
        Height="640" Width="720"
        MinHeight="520" MinWidth="560"
        Background="{StaticResource PaperBrush}"
        Foreground="{StaticResource InkBrush}"
        FontFamily="Segoe UI Variable Text, Segoe UI"
        FontSize="14">
  <DockPanel Margin="28,24">
    <StackPanel DockPanel.Dock="Top" Margin="0,0,0,18">
      <TextBlock Text="Pass-through Extensions"
                 FontSize="26" FontWeight="SemiBold"
                 FontFamily="Segoe UI Variable Display, Segoe UI"/>
      <TextBlock TextWrapping="Wrap" Margin="0,8,0,0"
                 Foreground="{StaticResource MutedBrush}"
                 Text="Meta-suffixes like .example and .old are badges on a real type. Enable the helper so Explorer peels them and opens the inner association. Add your own suffixes below."/>
    </StackPanel>

    <StackPanel DockPanel.Dock="Bottom" Margin="0,16,0,0">
      <TextBlock x:Name="StatusText" Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" TextWrapping="Wrap"/>
      <DockPanel>
        <StackPanel Orientation="Horizontal" DockPanel.Dock="Right">
          <Button Content="Remove from Explorer" Click="OnRemove" Padding="14,8" Margin="0,0,8,0"
                  Background="Transparent" BorderBrush="{StaticResource LineBrush}" Cursor="Hand"/>
          <Button Content="Apply to Explorer" Click="OnApply" Padding="16,8"
                  Background="{StaticResource TealBrush}" Foreground="White" BorderThickness="0"
                  FontWeight="SemiBold" Cursor="Hand"/>
        </StackPanel>
        <CheckBox x:Name="EnabledCheck" Content="Enabled for this user" VerticalAlignment="Center"
                  Foreground="{StaticResource InkBrush}"/>
      </DockPanel>
    </StackPanel>

    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="*"/>
        <ColumnDefinition Width="16"/>
        <ColumnDefinition Width="*"/>
      </Grid.ColumnDefinitions>

      <DockPanel Grid.Column="0">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="Built-in meta-types"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Uncheck to stop peeling a default. .old is included."/>
        <ListBox x:Name="DefaultsList" BorderBrush="{StaticResource LineBrush}"
                 Background="Transparent" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <CheckBox Content="{Binding Display}" IsChecked="{Binding IsEnabled, Mode=TwoWay}"
                        Margin="0,3" Foreground="{StaticResource InkBrush}"/>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>

      <DockPanel Grid.Column="2">
        <TextBlock DockPanel.Dock="Top" FontWeight="SemiBold" Margin="0,0,0,8"
                   Text="Your meta-types"/>
        <TextBlock DockPanel.Dock="Top" Foreground="{StaticResource MutedBrush}" FontSize="12"
                   Margin="0,0,0,8" TextWrapping="Wrap"
                   Text="Add a suffix without the dot (e.g. backup). Applied on Apply."/>
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,10">
          <Button DockPanel.Dock="Right" Content="Add" Click="OnAddCustom" Padding="12,6"
                  Margin="8,0,0,0" Background="{StaticResource AmberBrush}" BorderThickness="0"
                  Cursor="Hand"/>
          <TextBox x:Name="CustomInput" Padding="8,6"
                   BorderBrush="{StaticResource LineBrush}"
                   ToolTip="Suffix only — no leading dot"/>
        </DockPanel>
        <ListBox x:Name="CustomList" BorderBrush="{StaticResource LineBrush}"
                 Background="Transparent">
          <ListBox.ItemTemplate>
            <DataTemplate>
              <DockPanel Margin="0,2">
                <Button DockPanel.Dock="Right" Content="Remove" Click="OnRemoveCustom"
                        Tag="{Binding}" Padding="8,2" Margin="8,0,0,0"
                        Background="Transparent" BorderBrush="{StaticResource LineBrush}"
                        Cursor="Hand" FontSize="12"/>
                <TextBlock VerticalAlignment="Center" FontFamily="Consolas, Cascadia Mono">
                  <Run Text="."/><Run Text="{Binding}"/>
                </TextBlock>
              </DockPanel>
            </DataTemplate>
          </ListBox.ItemTemplate>
        </ListBox>
      </DockPanel>
    </Grid>
  </DockPanel>
</Window>
